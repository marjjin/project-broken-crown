instructions_label = NodePath("Panel/VBox/Instructions")
status_label = NodePath("Panel/VBox/Status")
capture_hint = NodePath("CaptureHint")
help_panel = NodePath("Panel")

[node name="Panel" type="PanelContainer" parent="."]
offset_left = 16.0
offset_top = 16.0
offset_right = 56.0
offset_bottom = 56.0
mouse_filter = 2
